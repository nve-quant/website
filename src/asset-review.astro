---
import Base from './layouts/Base.astro';
import {assetVariants} from './data/market-model';
---
<Base title="Asset material review"><main id="main"><a href="/review">Responsive review</a><h1>Asset material review</h1><p>Local still renders using the production geometry, materials and lighting. Select a specimen to inspect it without animation.</p><nav aria-label="Choose specimen">{Object.values(assetVariants).flat().map(asset=><button data-asset={asset.id}>{asset.label}</button>)}</nav><p id="result" role="status">Choose a specimen.</p><div id="asset-stage"></div></main></Base>
<script>
import {createMarketScene} from './scripts/market-scene';
import type {AssetVariantId} from './data/market-model';
const host=document.querySelector<HTMLElement>('#asset-stage')!;
const result=document.querySelector('#result')!;
let scene:ReturnType<typeof createMarketScene>|undefined;
document.querySelectorAll<HTMLButtonElement>('[data-asset]').forEach(button=>button.addEventListener('click',()=>{
 try {
  if(!scene){scene=createMarketScene(host,()=>{result.textContent='WebGL context lost';},()=>{});scene.visible(false);}
  scene.select(button.dataset.asset as AssetVariantId);
  const info=scene.renderStill();
  result.textContent=`${button.textContent}: rendered. ${info.triangles.toLocaleString()} triangles; ${info.geometries} resident geometries; ${info.textures} resident textures.`;
 }catch(error){result.textContent=`Render failed: ${String(error)}`;}
}));
window.addEventListener('error',event=>{result.textContent=`Browser error: ${event.message}`;});
window.addEventListener('pagehide',()=>scene?.dispose(),{once:true});
</script>
<style>main{max-width:1200px;margin:auto;padding:24px}h1{font-size:2rem}nav{display:flex;flex-wrap:wrap;gap:8px}button{padding:10px 16px;border:1px solid #89987c;background:#e6ebd9;color:#243f35;cursor:pointer}#asset-stage{height:600px;background:#e6ebd9}#asset-stage :global(canvas){width:100%;height:100%}#result{max-width:none;font-size:.85rem}</style>
