---
import Base from './layouts/Base.astro';
import {directions} from './data/site';
---
<Base title="Responsive review"><main id="main"><a href="/studies">All concepts</a><h1>Responsive review</h1><p>Local review tool. Each preview uses the exact viewport width shown.</p><nav aria-label="Select preview">{[{id:'home',name:'Homepage'},{id:'market-making',name:'CEX service'},{id:'dex-liquidity-management',name:'DEX service'},{id:'work',name:'How we work'},{id:'company',name:'Company'},...directions].map(d=><div><strong>{d.name}</strong>{[375,768,1440].map(w=><button data-concept={d.id} data-width={w}>{d.name} {w}px</button>)}</div>)}</nav><nav id="section-review" aria-label="Review page sections"></nav><p id="result" aria-live="polite">Choose a preview.</p><div class="stage"><iframe title="Concept preview" width="375" height="2000"></iframe></div></main></Base>
<script>
const frame=document.querySelector('iframe')!;
const result=document.querySelector('#result')!;
document.querySelectorAll<HTMLButtonElement>('button[data-concept]').forEach(button=>button.addEventListener('click',()=>{
 frame.width=button.dataset.width!;const page=button.dataset.concept!;frame.src=page === 'home' ? '/' : ['market-making','dex-liquidity-management','work','company'].includes(page)?`/${page}`:`/concepts/${page}`;result.textContent='Loading preview…';
}));
frame.addEventListener('load',async()=>{
 const doc=frame.contentDocument;if(!doc||!frame.getAttribute('src'))return;
 await doc.fonts.ready;
 const sections=document.querySelector('#section-review')!;
 sections.replaceChildren();
 const top=document.createElement('button');top.textContent='Review: Page top';
 top.addEventListener('click',()=>doc.documentElement.scrollIntoView({block:'start'}));sections.append(top);
 for(const heading of doc.querySelectorAll<HTMLElement>('h1,h2')){
  const button=document.createElement('button');
  button.textContent=`Review: ${heading.textContent?.replace(/\s+/g,' ').trim()}`;
  button.addEventListener('click',()=>heading.scrollIntoView({block:'start'}));
  sections.append(button);
 }
 const measure=()=>{
 frame.height=String(doc.documentElement.scrollHeight);
 const overflow=doc.documentElement.scrollWidth>Number(frame.width);
 const brokenImages=Array.from(doc.images).filter(image=>image.complete&&!image.naturalWidth);
 const invalidAnchors=Array.from(doc.querySelectorAll<HTMLAnchorElement>('a[href^="#"]')).filter(a=>!doc.querySelector(a.getAttribute('href')!));
 result.textContent=`${frame.width}px: ${overflow?'FAIL: horizontal overflow':'PASS: no horizontal overflow'}; ${invalidAnchors.length} broken section links; ${brokenImages.length} broken images; fonts ${doc.fonts.status}.`;
 };
 measure();
 doc.addEventListener('change',()=>requestAnimationFrame(measure));
 doc.addEventListener('toggle',()=>requestAnimationFrame(measure),true);
});
</script>
<style>main{padding:24px}h1{font-size:2rem;margin:24px 0 12px}nav{display:flex;flex-wrap:wrap;gap:24px}nav#section-review{gap:8px;margin:20px 0}nav#section-review button{font-size:.75rem}nav div{display:flex;flex-wrap:wrap;gap:8px;align-items:center}button{padding:8px;border:1px solid #80929c;background:white;color:#182b39;cursor:pointer}.stage{overflow:auto;background:#e7ebee;padding:16px}iframe{display:block;background:white;border:0;max-width:none}#result{font-weight:bold;max-width:none}</style>
