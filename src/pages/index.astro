---
import VenueCoverage from '../components/VenueCoverage.astro';
import Experience from '../components/Experience.astro';
import Marketing from '../layouts/Marketing.astro';
import MeasurementGraphic from '../components/MeasurementGraphic.astro';
import MarketScenarios from '../components/MarketScenarios.astro';
import {experience} from '../data/experience';
import ReviewNote from '../components/ReviewNote.astro';
import Access from '../components/Access.astro';
import Reporting from '../components/Reporting.astro';
import EngagementContact from '../components/EngagementContact.astro';
import EngagementFlow from '../components/EngagementFlow.astro';
import SupplementaryServiceGraphic from '../components/SupplementaryServiceGraphic.astro';
import AssetMarket from '../components/AssetMarket.astro';
import LiquidityServices from '../components/LiquidityServices.astro';
import {site} from '../data/site';
import {services,homepage} from '../data/home';
import {getCollection} from 'astro:content';
const research=(await getCollection('research'))[0].data;
---
<Marketing title={homepage.title} description={homepage.description}>
 <section class="home-hero" aria-labelledby="home-title">
  <a class="hero-research" href={research.source}><span>From our research</span><span>{research.title}</span><span aria-hidden="true">↗</span></a>
  <div class="hero-main"><p class="hero-audience">For exchanges, token teams and asset issuers</p><h1 id="home-title">The work behind<br/>a liquid market.</h1></div>
  <div class="hero-intro"><p>Market making on CEX and DEX. We manage quotes, inventory and liquidity positions from your own accounts, with real-time visibility into the work.</p><a class="home-button" href={`mailto:${site.email}`}>Discuss your market</a><a class="hero-secondary" href="/work">How we work</a></div>
  <div class="hero-foot"><span>CEX market making</span><span>DEX liquidity management</span><span>Non-custodial operation</span></div>
 </section>
 <LiquidityServices/>
 <VenueCoverage/>
 <MarketScenarios/>
 <section class="home-scorecard editorial-section" aria-labelledby="scorecard-title"><div><p class="section-kicker">Measurement before promises</p><h2 id="scorecard-title">Judge the work<br/>by your market.</h2></div><div><p>For an order book, discuss spread, executable depth and quote availability. For a liquidity pool, consider active allocation, trading impact and the economics of the position.</p><p>Agree the measures, then compare observations with targets. Market conditions, capital and operating costs belong in the same review.</p><div class="inline-links"><a href="/market-making#measurement">CEX measurement framework</a><a href="/dex-liquidity-management#measurement">DEX measurement framework</a></div></div><MeasurementGraphic/></section>
 <ReviewNote title="Place verified evidence near the offer" items={['Add one permitted client case: problem, capital and market context, work performed, observed results and measurement period.','Named engagements are owner-approved. Add measured case outcomes and approved biographies when available.']}/>
 <Experience/>
 <section class="home-people" aria-labelledby="home-people-title"><div><p>People behind the operation</p><h2 id="home-people-title">Close to the systems.<br/>Close to your market.</h2><a href="/company">Meet Onchain Bureau</a></div><div class="people-names">{experience.people.map(person=><article><h3>{person.name}</h3><p>{person.role}</p></article>)}<p>Both co-founders work across technical, operational and commercial decisions.</p></div></section>
 <Access/>
 <Reporting/>
 <ReviewNote title="Show the existing dashboard" items={['Provide a real, sanitised screenshot or recording annotated around market activity, target comparison and exceptions.','Confirm history, refresh frequency, export scope and CEX/DEX coverage. The dashboard is already operational; only its public evidence is missing.']}/>
 <section id="approach" class="home-approach" aria-labelledby="approach-title"><div class="approach-intro"><p>How we work</p><h2 id="approach-title">An agreed scope.<br/>A clear way to operate.</h2><p>The mandate defines the work, its limits and how it will be reviewed. Four steps connect the initial market review to ongoing operation.</p><div class="inline-links"><a href="/work">Explore how we work</a><a href="/company">About Onchain Bureau</a></div></div><EngagementFlow/></section>
 <section class="home-services" aria-labelledby="services-title"><div class="section-intro"><h2 id="services-title">Around the mandate.</h2><p>Additional services for your market.<br/>Scoped to the work you need.</p></div><div class="service-list">{services.map((service)=><details class="service-row" id={service.id}><summary><span class="service-name">{service.name}</span><span class="service-summary">{service.summary}</span><span class="disclosure" aria-hidden="true"></span></summary><div class="service-expanded">{(service.id==='otc-deals'||service.id==='systematic-strategies')&&<SupplementaryServiceGraphic kind={service.id}/>}<p class="service-for">{service.for}</p><div><p>{service.detail}</p><a href={`mailto:${site.email}?subject=${encodeURIComponent(service.name+' enquiry')}`}>Discuss {service.name.toLowerCase()}</a></div></div></details>)}</div></section>
 <div class="home-asset-studies"><AssetMarket/></div>
 <section id="research" class="home-research" aria-labelledby="research-title"><div class="research-intro"><h2 id="research-title">Questions from<br/>the market.</h2><p>Research on the details that shape how tokenized assets trade.</p></div><article><p class="research-topic">Asset structure</p><h3><a href={research.source}>{research.title}</a></h3><p>{research.summary}</p><a class="research-link" href={research.source}>Read the research note</a></article></section>
 <EngagementContact/>
</Marketing>
