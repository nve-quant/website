---
import Base from '../layouts/Base.astro';
import AssetMarket from '../components/AssetMarket.astro';
import LiquidityServices from '../components/LiquidityServices.astro';
import {site} from '../data/site';
import {services,steps,homepage} from '../data/home';
import {getCollection} from 'astro:content';
import '@fontsource/public-sans/400.css';
import '@fontsource/public-sans/500.css';
import '../styles/home.css';
const research=(await getCollection('research'))[0].data;
---
<Base title={homepage.title} description={homepage.description} theme="home">
 <div class="home-shell">
 <header class="home-header"><a class="home-wordmark" href="/" aria-label="Onchain Bureau home">Onchain<br/>Bureau<span aria-hidden="true"></span></a><nav aria-label="Main navigation"><a href="#services">Services</a><a href="#asset-studies">Asset studies</a><a href="#research">Research</a><a href="#contact" class="nav-contact">Talk to us</a></nav></header>
 <main id="main">
 <section class="home-hero" aria-labelledby="home-title"><div><p class="hero-audience">Market making as a service</p><h1 id="home-title">Market making.<br/>On CEX and DEX.</h1></div><div class="hero-intro"><p>{homepage.intro}</p><a class="home-button" href={`mailto:${site.email}`}>{site.contact}</a></div></section>
 <LiquidityServices/>
 <section class="home-services" aria-labelledby="services-title"><div class="section-intro"><h2 id="services-title">Around the mandate.</h2><p>Additional services for your market.<br/>Scoped to the work you need.</p></div><div class="service-list">{services.map((service)=><details class="service-row"><summary><span class="service-name">{service.name}</span><span class="service-summary">{service.summary}</span><span class="disclosure" aria-hidden="true"></span></summary><div class="service-expanded"><p class="service-for">{service.for}</p><div><p>{service.detail}</p><a href={`mailto:${site.email}?subject=${encodeURIComponent(service.name+' enquiry')}`}>Discuss {service.name.toLowerCase()}</a></div></div></details>)}</div></section>
 <section id="approach" class="home-approach" aria-labelledby="approach-title"><div class="approach-intro"><p>How we work</p><h2 id="approach-title">An agreed scope.<br/>A clear way to operate.</h2><p>The engagement starts with your markets and the outcome you need. The mandate defines the work, its limits and how it will be reviewed.</p></div><ol>{steps.map(step=><li><h3>{step.title}</h3><p>{step.text}</p></li>)}</ol></section>
 <div class="home-asset-studies"><AssetMarket/></div>
 <section id="research" class="home-research" aria-labelledby="research-title"><div class="research-intro"><h2 id="research-title">Questions from<br/>the market.</h2><p>Research on the details that shape how tokenized assets trade.</p></div><article><p class="research-topic">Asset structure</p><h3><a href={research.source}>{research.title}</a></h3><p>{research.summary}</p><a class="research-link" href={research.source}>Read the research note</a></article></section>
 <aside class="platform-note" aria-label="Platform development"><span>In development</span><p>We’re developing an asset-level view of markets, reference prices and liquidity.</p><a href={`mailto:${site.email}?subject=Platform%20enquiry`}>Ask about the platform</a></aside>
 <section id="contact" class="home-contact" aria-labelledby="contact-title"><div><p>Let’s talk liquidity.</p><h2 id="contact-title">What does your<br/>market need?</h2></div><div class="contact-copy"><p>Tell us about your token, the exchanges or pools you use, and what you want to improve.</p><a class="contact-email" href={`mailto:${site.email}`}>{site.email}</a><p class="contact-audience">For token issuers, crypto teams<br/>and tokenization platforms.</p></div></section>
 </main>
 <footer class="home-footer"><a class="footer-name" href="#main">Onchain Bureau</a><nav aria-label="Footer navigation"><a href="https://onchainbureau.com/company">Company</a><a href="https://onchainbureau.com/legal">Legal</a><a href="https://t.me/onchainbureau">Telegram</a><a href={`mailto:${site.email}`}>Email</a></nav><p>CEX market making. DEX liquidity management.</p></footer>
 </div>
</Base>
