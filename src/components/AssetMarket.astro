---
import {marketModels} from '../data/market-model';
import '../styles/market-model.css';
---
<section class="market-explorer" aria-labelledby="explorer-title" data-market-explorer>
  <div class="explorer-heading"><div><p>Explore the market design</p><h2 id="explorer-title">Different assets.<br/>Different mechanics.</h2></div><p>Choose an asset to see <br/>what changes around it.</p></div>
  <fieldset class="asset-selector"><legend class="visually-hidden">Choose an illustrative asset type</legend>{marketModels.map((model,index)=><label><input type="radio" name="market-asset" value={model.id} checked={index===0} aria-controls={`model-${model.id}`}/><span>{model.label}</span></label>)}</fieldset>
  <div class="explorer-body">
    <div class="model-stage">
      <div class="model-axis axis-a" aria-hidden="true"></div><div class="model-axis axis-b" aria-hidden="true"></div>
      <div class="model-canvas" data-model-canvas aria-hidden="true"></div>
      <div class="model-fallback" aria-hidden="true">
        <svg class="fallback-gold" viewBox="0 0 500 400"><ellipse cx="250" cy="313" rx="169" ry="41" fill="#c4cdac"/><g stroke="#80642c" stroke-width="2"><path d="m100 210 185-70 110 55-186 78Z" fill="#e4bc62"/><path d="m100 210 109 63v46l-109-63Z" fill="#a48237"/><path d="m209 273 186-78v45l-186 79Z" fill="#c79a42"/><path d="m137 155 143-56 91 44-145 60Z" fill="#f4d78e"/><path d="m137 155 89 48v40l-89-48Z" fill="#b08a3d"/><path d="m226 203 145-60v40l-145 60Z" fill="#d5ab50"/></g></svg>
        <svg class="fallback-fund" viewBox="0 0 500 400"><ellipse cx="250" cy="323" rx="150" ry="32" fill="#c4cdac"/>{[0,1,2,3].map(i=><g transform={`translate(0 ${-i*44})`} stroke="#476654" stroke-width="2"><path d="m130 260 120-44 120 44-120 44Z" fill="#e9efd7"/><path d="m130 260 120 44v16l-120-44Z" fill="#668a6b"/><path d="m250 304 120-44v16l-120 44Z" fill="#adc795"/></g>)}</svg>
        <svg class="fallback-unique" viewBox="0 0 500 400"><ellipse cx="250" cy="332" rx="122" ry="26" fill="#c4cdac"/><g stroke="#295644" stroke-width="2"><path d="m250 60 105 80-20 131-85 55-108-99 13-105Z" fill="#619b75"/><path d="m250 60-15 111 120-31Z" fill="#b6d7a4"/><path d="m155 122 80 49 15-111Z" fill="#88ba8a"/><path d="m235 171 100 100 20-131Z" fill="#396f56"/><path d="m235 171 15 155 85-55Z" fill="#234d3f"/><path d="m142 227 108 99-15-155Z" fill="#76a17c"/></g></svg>
      </div>
      <div class="model-caption">{marketModels.map(model=><p data-caption={model.id}>{model.object}</p>)}<span>Illustrative asset study</span></div>
      <div class="model-controls" hidden><button type="button" data-rotate="-1" aria-label="Rotate model left">↶</button><button type="button" data-spin aria-pressed="false">Rotate model</button><button type="button" data-rotate="1" aria-label="Rotate model right">↷</button></div>
    </div>
    <div class="model-explanation">
      {marketModels.map(model=><article id={`model-${model.id}`} class="model-panel" data-panel={model.id} aria-labelledby={`title-${model.id}`}><h3 id={`title-${model.id}`}>{model.title}</h3><p class="model-intro">{model.intro}</p><dl><div><dt>Reference price</dt><dd>{model.reference}</dd></div><div><dt>Liquidity</dt><dd>{model.liquidity}</dd></div><div><dt>Redemption</dt><dd>{model.redemption}</dd></div></dl><details class="model-question"><summary>{model.question}<span aria-hidden="true">+</span></summary><p>{model.answer}</p><a href={model.source}>Read more about this structure</a></details></article>)}
    </div>
  </div>
  <div class="model-routes" aria-label="Illustrative market relationships">{marketModels.map(model=><ol data-route={model.id}>{model.route.map(item=><li>{item}</li>)}</ol>)}</div>
  <p class="model-disclaimer">Illustrative structures, not live markets. Terms vary by asset and issuer.</p>
  <p class="visually-hidden" aria-live="polite" data-model-status></p>
</section>
<script>
  import {initMarketExplorer} from '../scripts/market-explorer';
  document.querySelectorAll<HTMLElement>('[data-market-explorer]').forEach(initMarketExplorer);
</script>
