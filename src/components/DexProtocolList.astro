---
import type {DexDeployment} from '../data/venue-coverage';
interface Props {protocols: DexDeployment[]; planned?: boolean;}
const {protocols,planned=false}=Astro.props;
---
<ul class:list={['protocol-marks',{'planned-protocols':planned}]}>
 {protocols.map(protocol=><li data-market-kind={protocol.category} data-coverage-status={protocol.status}>
  {protocol.logo&&<div class="protocol-mark"><img src={protocol.logo} alt="" width="40" height="40" loading="lazy" draggable="false"/></div>}
  <div class="protocol-description">
   {planned&&<p class="market-kind">{{pools:'Liquidity pools',launchpads:'Launchpad',trading:'Trading venue'}[protocol.category]}</p>}
   <span class="protocol-name">{protocol.protocol}</span>
   {protocol.products.length>0&&<ul class="pool-families" aria-label={protocol.protocol+' '+(protocol.category==='pools'?'pool families':'markets')}>{protocol.products.map(product=><li>{product}</li>)}</ul>}
   {!planned&&protocol.chains&&<p class="protocol-chains"><span class="sr-only">Chains: </span>{protocol.chains.join(' · ')}</p>}
   {!planned&&protocol.additionalDeployments?.map(deployment=><p class="protocol-chains additional-deployment"><span>{deployment.products.join(' / ')}</span> · {deployment.chains.join(' · ')}</p>)}
  </div>
 </li>)}
</ul>
<style>
.sr-only{position:absolute;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip:rect(0,0,0,0);white-space:nowrap;border:0}
.protocol-marks{list-style:none;padding:0;margin:0;display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:28px 22px;align-items:start}
.protocol-marks>li{display:grid;grid-template-columns:40px minmax(0,1fr);gap:13px;align-items:start;min-width:0}
.protocol-mark{height:40px;display:flex;justify-content:center;align-items:center}
.protocol-mark img{object-fit:contain;max-width:100%;filter:grayscale(1)}
.protocol-marks>li:hover img{filter:grayscale(0)}
.protocol-description{padding-top:1px;min-width:0}
.protocol-name{display:block;font-size:.9rem;line-height:1.5;font-weight:500}
.pool-families{list-style:none;padding:0;margin:5px 0 0;display:flex;flex-wrap:wrap;gap:3px 0;font-size:.75rem;line-height:1.6;color:var(--muted)}
.pool-families li:not(:last-child)::after{content:'/';padding:0 6px}
.protocol-chains{font-size:.7rem;line-height:1.7;color:var(--muted);margin:10px 0 0}
.additional-deployment{color:var(--ink)}
.additional-deployment span{font-weight:500}
.market-kind{font-size:.65rem;line-height:1.5;color:var(--muted);margin:0 0 4px}
.planned-protocols{grid-template-columns:repeat(3,minmax(0,1fr))}
.planned-protocols .protocol-mark{padding-top:20px;height:60px}
@media(max-width:1200px){.protocol-marks{grid-template-columns:repeat(2,minmax(0,1fr));gap:28px}}
@media(max-width:440px){.protocol-marks{grid-template-columns:1fr;gap:24px}.protocol-name{font-size:1rem}.pool-families{font-size:.8rem}.protocol-chains{font-size:.75rem}.market-kind{font-size:.7rem}}
@media(prefers-reduced-motion:no-preference){.protocol-mark img{transition:filter .2s ease}}
</style>
