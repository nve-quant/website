---
import {coreServices, services} from '../data/home';
const home=Astro.url.pathname==='/';
const section=(id:string)=>home?`#${id}`:`/#${id}`;
const current=Astro.url.pathname.replace(/\/$/,'');
const executionIds=new Set(['otc-deals','systematic-strategies','treasury-execution']);
const executionServices=services.filter(service=>executionIds.has(service.id));
const marketServices=services.filter(service=>!executionIds.has(service.id));
---
<header class="home-header">
 <a class="home-wordmark" href="/" aria-label="Onchain Bureau home"><svg viewBox="0 0 64 64" aria-hidden="true"><path d="M11 8v48M11 8h25c10 0 16 5 16 13S46 33 36 33H11M11 33h27c10 0 16 4 16 12s-6 11-16 11H11M24 21h16M24 45h19"/></svg><span class="brand-name">Onchain<br/>Bureau</span></a>
 <nav aria-label="Main navigation">
  <details class="services-nav" data-services-nav>
   <summary aria-controls="services-dropdown">Services <svg width="10" height="6" viewBox="0 0 10 6" aria-hidden="true"><path d="m1 1 4 4 4-4" fill="none" stroke="currentColor" stroke-width="1.3"/></svg></summary>
   <div class="services-panel" id="services-dropdown">
    <div class="services-primary">
     <p class="services-group-label">Liquidity management</p>
     {coreServices.map(service=>{
      const href=service.id==='cex'?'/market-making':'/dex-liquidity-management';
      return <a class="services-primary-link" href={href} aria-current={current===href?'page':undefined}><span class="services-link-title">{service.title}</span><span class="services-link-description">{service.intro}</span><span class="services-link-scope">{service.scope.join(' · ')}</span></a>;
     })}
    </div>
    <div class="services-execution">
     <p class="services-group-label">Execution & strategy</p>
     {executionServices.map(service=><a class="services-supporting-link" href={section(service.id)}><span class="services-link-title">{service.name}</span><span class="services-link-description">{service.summary}</span></a>)}
    </div>
    <div class="services-supporting">
     <p class="services-group-label">Market support</p>
     {marketServices.map(service=><a class="services-supporting-link" href={section(service.id)}><span class="services-link-title">{service.name}</span><span class="services-link-description">{service.summary}</span></a>)}
    </div>
    <div class="services-panel-footer"><a href={section('services')}>View service overview</a><a href="/work">How an engagement works</a></div>
   </div>
  </details>
  <a href="/work" aria-current={current==='/work'?'page':undefined}>How we work</a>
  <a href={section('asset-studies')}>Asset studies</a>
  <a href={section('research')}>Research</a>
  <a href={section('contact')} class="nav-contact">Talk to us</a>
 </nav>
</header>

<style>
 .home-header{position:relative;z-index:5}
 .services-nav>summary{display:flex;align-items:center;gap:8px;cursor:pointer;list-style:none;padding:10px 0}
 .services-nav>summary::-webkit-details-marker{display:none}
 .services-nav[open]>summary{text-decoration:underline;text-underline-offset:6px}
 .services-nav[open]>summary svg{transform:rotate(180deg)}
 .services-panel{position:absolute;top:calc(100% - 18px);right:0;width:min(1120px,100%);background:var(--ground);border:1px solid var(--line);border-top:3px solid var(--ink);display:grid;grid-template-columns:1.15fr 1fr 1fr;padding:30px 32px 0;column-gap:32px;max-height:calc(100dvh - 140px);overflow:auto;overscroll-behavior:contain}
 .services-group-label{font-size:.75rem;color:var(--muted);margin:0 0 8px}
 .services-primary,.services-execution{border-right:1px solid var(--line);padding-right:28px}
 .home-header .services-panel a{display:block;text-decoration:none;padding:16px 0}
 .home-header .services-panel a:hover .services-link-title,.home-header .services-panel a:focus-visible .services-link-title{text-decoration:underline;text-underline-offset:5px}
 .services-link-title,.services-link-description,.services-link-scope{display:block}
 .services-link-title{font-weight:500;line-height:1.25}
 .services-primary-link .services-link-title{font-size:1.5rem;letter-spacing:-.035em}
 .services-link-description{font-size:.8rem;line-height:1.5;color:var(--muted);margin-top:8px;max-width:38ch}
 .services-link-scope{font-size:.7rem;line-height:1.6;margin-top:14px;max-width:36ch}
 .services-primary-link+.services-primary-link,.services-supporting-link+.services-supporting-link{border-top:1px solid var(--line)}
 .services-supporting-link .services-link-title{font-size:.95rem}
 .services-supporting-link .services-link-description{margin-top:5px;font-size:.75rem}
 .services-panel-footer{grid-column:1/-1;display:flex;justify-content:space-between;gap:20px;margin-top:24px;border-top:1px solid var(--line)}
 .home-header .services-panel-footer a{font-size:.75rem;padding:20px 0;text-decoration:underline}
 @media(min-width:601px) and (max-width:1000px){
  .services-panel{grid-template-columns:1fr 1fr;gap:0 28px}
  .services-execution{border-right:0;padding-right:0}
  .services-supporting{grid-column:1/-1;display:grid;grid-template-columns:1fr 1fr;column-gap:28px;border-top:1px solid var(--line);margin-top:20px;padding-top:20px}
  .services-supporting .services-group-label{grid-column:1/-1}
  .services-supporting-link+.services-supporting-link{border-top:0}
  .services-supporting .services-supporting-link:nth-of-type(n+3){border-top:1px solid var(--line)}
 }
 @media(max-width:600px){
  .services-nav>summary{padding:5px 0;gap:5px}
  .services-panel{top:calc(100% - 8px);grid-template-columns:1fr;padding:20px 22px 0;max-height:calc(100dvh - 165px)}
  .services-primary,.services-execution{border-right:0;padding-right:0}
  .services-primary-link .services-link-title{font-size:1.2rem}
  .services-link-scope{display:none}
  .services-supporting,.services-execution{border-top:1px solid var(--line);margin-top:8px;padding-top:20px}
  .services-panel-footer{display:block;margin-top:12px;padding-block:8px}
  .home-header .services-panel-footer a{padding:12px 0}
 }
</style>

<script>
 const dropdown=document.querySelector<HTMLDetailsElement>('[data-services-nav]');
 if(dropdown){
  const trigger=dropdown.querySelector('summary')!;
  const panel=dropdown.querySelector<HTMLElement>('.services-panel')!;
  let closeTimer:ReturnType<typeof setTimeout>|undefined;
  let openedByHover=false;
  const cancelClose=()=>clearTimeout(closeTimer);
  const close=()=>{cancelClose();dropdown.open=false;openedByHover=false;};
  const hover=matchMedia('(hover: hover) and (pointer: fine)');
  dropdown.addEventListener('pointerenter',event=>{
   if(event.pointerType==='mouse'&&hover.matches){cancelClose();openedByHover=!dropdown.open;dropdown.open=true;}
  });
  trigger.addEventListener('click',event=>{
   // Moving onto the trigger already opens it; the first mouse click keeps it open.
   if(openedByHover&&event.detail>0){event.preventDefault();openedByHover=false;}
  });
  dropdown.addEventListener('pointerleave',event=>{
   if(event.pointerType==='mouse')closeTimer=setTimeout(()=>{
    if(!panel.contains(document.activeElement))close();
   },220);
  });
  dropdown.addEventListener('focusin',cancelClose);
  dropdown.addEventListener('focusout',event=>{
   if(!dropdown.contains(event.relatedTarget as Node|null))close();
  });
  dropdown.addEventListener('keydown',event=>{
   if(event.key==='Escape'){event.preventDefault();close();trigger.focus();}
   if(event.target===trigger&&event.key==='ArrowDown'){
    event.preventDefault();cancelClose();dropdown.open=true;panel.querySelector('a')?.focus();
   }
  });
  document.addEventListener('pointerdown',event=>{
   if(!dropdown.contains(event.target as Node))close();
  });
  dropdown.addEventListener('click',event=>{
   const link=(event.target as Element).closest('a');
   if(link){
    const target=document.getElementById(link.hash.slice(1));
    if(target instanceof HTMLDetailsElement&&target.classList.contains('service-row'))target.open=true;
    close();
   }
  });
 }
 // Supporting-service links land on an expanded explanation, including cross-page visits.
 const revealService=()=>{
  const target=document.getElementById(location.hash.slice(1));
  if(target instanceof HTMLDetailsElement&&target.classList.contains('service-row')){
   target.open=true;
   target.scrollIntoView({block:'start'});
  }
 };
 revealService();
 window.addEventListener('hashchange',revealService);
</script>
