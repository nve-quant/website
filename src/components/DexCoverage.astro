---
import {dexDeployments,evmChains,chainLogos} from '../data/venue-coverage';
import DexProtocolList from './DexProtocolList.astro';
interface Props {standalone?: boolean;}
const {standalone=false}=Astro.props;
const Ecosystem=standalone?'section':'details';
const EcosystemHeader=standalone?'header':'summary';
const Heading=standalone?'h2':'h3';
const GroupHeading=standalone?'h3':'h4';
const CategoryHeading=standalone?'h4':'h5';
const groups=[
 {name:'EVM',description:evmChains.join(' · ')},
 {name:'Solana',description:'Liquidity pools, launch markets and direct onchain execution.'},
] as const;
const categories=[
 {id:'pools',name:'Liquidity pools',description:'Concentrated and full-range liquidity.'},
 {id:'launchpads',name:'Launchpads & bonding curves',description:'Launch-market execution, scoped separately from pool management.'},
 {id:'trading',name:'Other trading venues',description:'Order-book and proprietary-AMM execution.'},
] as const;
---
<section class:list={['dex-coverage',{'dex-standalone':standalone}]} aria-label="Decentralized exchange coverage">
 <div class="dex-intro"><Heading>{standalone?'Supported DEXs and market structures.':'Decentralized exchanges'}</Heading><p>Find the right venue for your liquidity or trading mandate.</p></div>
 <div class="dex-ecosystems">{groups.map(group=>{
  const upcoming=dexDeployments.filter(item=>item.network===group.name&&item.status==='coming-soon');
  return <Ecosystem class:list={['dex-ecosystem',{'solana-ecosystem':group.name==='Solana'}]} aria-label={group.name+' protocol coverage'}>
   <EcosystemHeader class="ecosystem-heading"><GroupHeading>{group.name==='Solana'&&<img class="ecosystem-logo" src={chainLogos.Solana} width="30" height="30" alt=""/>}{group.name}</GroupHeading>{group.name==='EVM'?<span class="chain-list" aria-label="Supported EVM chains">{evmChains.map(chain=><span class="chain-chip"><img src={chainLogos[chain]} width="20" height="20" alt="" loading="lazy"/><span>{chain}</span></span>)}</span>:<p>{group.description}</p>}{!standalone&&<span class="coverage-expand"><span>Explore protocols</span><span aria-hidden="true">+</span></span>}</EcosystemHeader>
   <div class="ecosystem-markets">
    {categories.map(category=>{
     const protocols=dexDeployments.filter(item=>item.network===group.name&&item.status==='available'&&item.category===category.id);
     return protocols.length>0&&<section class="market-category" aria-label={group.name+' '+category.name}>
      <header class="category-heading"><CategoryHeading>{category.name}</CategoryHeading><p>{category.description}</p></header>
      <DexProtocolList protocols={protocols}/>
     </section>;
    })}
    {upcoming.length>0&&<section class="upcoming-coverage" aria-label="Additional Robinhood Chain venues coming soon">
     <header class="upcoming-heading"><CategoryHeading>More on Robinhood Chain</CategoryHeading><span class="coverage-status">Coming soon</span></header>
     <p class="upcoming-intro">Uniswap v4 is already supported. Next: native DEX pools and launchpads.</p>
     <DexProtocolList protocols={upcoming} planned/>
    </section>}
   </div>
  </Ecosystem>;
 })}</div>
 <div class="dex-footnote"><p>Pool management, launch-market execution and other trading are separate activities. We agree the deployment, pool or market, and permissions for your engagement.</p>{!standalone&&<a href="/dex-liquidity-management">Explore DEX liquidity management</a>}</div>
</section>
<style>
.dex-coverage{margin-top:56px}
.dex-standalone{margin:0 0 var(--section);padding-top:32px}
.dex-intro{display:flex;justify-content:space-between;align-items:baseline;gap:24px;margin-bottom:28px}
.dex-intro h3{font-size:1rem;margin:0}
.dex-intro h2{font-size:clamp(1.8rem,3.2vw,3rem);max-width:23ch;margin:0}
.dex-intro>p{font-size:.85rem;line-height:1.6;color:var(--muted);max-width:32ch;margin:0}
.dex-ecosystems{border-block:1px solid var(--line)}
.dex-ecosystem{display:grid;grid-template-columns:minmax(140px,1fr) minmax(0,5fr);gap:40px;padding:32px 0 38px}
.dex-ecosystem+.dex-ecosystem{border-top:1px solid var(--line)}
.ecosystem-heading{min-width:0}
.ecosystem-heading :is(h3,h4){font-weight:400;font-size:1.8rem;letter-spacing:-.04em;margin:0 0 10px}
.ecosystem-heading p{font-size:.75rem;line-height:1.8;color:var(--muted);max-width:20ch;margin:0}
.ecosystem-markets{min-width:0}
.market-category+.market-category{margin-top:32px;padding-top:26px;border-top:1px solid var(--line)}
.category-heading{margin:0 0 24px}
.category-heading :is(h4,h5){font-size:.85rem;font-weight:500;letter-spacing:0;margin:0}
.category-heading p{font-size:.75rem;line-height:1.6;color:var(--muted);margin:6px 0 0}
.upcoming-coverage{background:var(--ground);border:1px solid var(--line);margin-top:32px;padding:22px 24px}
.upcoming-heading{display:flex;gap:12px 20px;align-items:center;justify-content:space-between;flex-wrap:wrap}
.upcoming-heading :is(h4,h5){font-size:1rem;font-weight:500;letter-spacing:0;margin:0}
.coverage-status{font-size:.65rem;line-height:1.5;color:var(--ink);background:var(--accent);padding:5px 9px;border-radius:2px;white-space:nowrap}
.upcoming-intro{font-size:.75rem;line-height:1.6;color:var(--muted);margin:10px 0 22px}
.dex-footnote{display:flex;align-items:baseline;justify-content:space-between;gap:24px;margin-top:20px}
.dex-footnote p{font-size:.75rem;line-height:1.65;color:var(--muted);max-width:76ch;margin:0}
.dex-footnote a{font-size:.8rem;flex-shrink:0}
@media(max-width:1100px){.dex-ecosystem{grid-template-columns:130px minmax(0,1fr);gap:28px}}
@media(max-width:700px){.dex-ecosystem{grid-template-columns:1fr;gap:26px}.ecosystem-heading{display:flex;justify-content:space-between;align-items:baseline;gap:24px}.ecosystem-heading p{max-width:28ch}.ecosystem-heading :is(h3,h4){margin:0}.dex-intro{display:block}.dex-intro>p{margin-top:12px}.dex-footnote{display:block}.dex-footnote a{display:inline-block;margin-top:16px}}
@media(max-width:440px){.ecosystem-heading p{max-width:25ch}.dex-ecosystem{padding:28px 0 32px}.upcoming-coverage{padding:20px}.category-heading{margin-bottom:22px}.coverage-status{font-size:.7rem}}

.dex-ecosystem:is(details){display:block;padding:0}
details>.ecosystem-heading{display:grid;grid-template-columns:150px 1fr auto;gap:28px;align-items:center;cursor:pointer;list-style:none;padding:28px 0}
details>.ecosystem-heading::-webkit-details-marker{display:none}
details>.ecosystem-heading :is(h3,h4){margin:0}
details>.ecosystem-heading p{max-width:60ch}
.coverage-expand{display:flex;gap:24px;align-items:center;font-size:.75rem}
.coverage-expand>span:last-child{font-size:1.8rem;font-weight:400;transition:transform .2s}
details[open] .coverage-expand>span:last-child{transform:rotate(45deg)}
details>.ecosystem-markets{padding:8px 0 32px 178px}
@media(max-width:700px){details>.ecosystem-heading{grid-template-columns:1fr auto;gap:10px 18px}details>.ecosystem-heading p{grid-column:1;grid-row:2}details>.ecosystem-heading .coverage-expand{grid-column:2;grid-row:1/3}.coverage-expand>span:first-child{display:none}details>.ecosystem-markets{padding:8px 0 28px}}
@media(prefers-reduced-motion:reduce){.coverage-expand>span:last-child{transition:none}}

.ecosystem-heading :is(h3,h4){display:flex;align-items:center;gap:12px}
.ecosystem-logo{object-fit:contain;flex:none}
.chain-list{display:flex;flex-wrap:wrap;gap:12px 18px;min-width:0}
.chain-chip{display:inline-flex;align-items:center;gap:7px;font-size:.75rem;line-height:1.5;color:var(--muted);white-space:nowrap}
.chain-chip img{object-fit:contain;flex:none}.chain-chip img,.ecosystem-logo{filter:grayscale(1)}
.chain-chip:hover img,.ecosystem-heading:hover .ecosystem-logo,.ecosystem-heading:focus-visible img{filter:grayscale(0)}
@media(prefers-reduced-motion:no-preference){.chain-chip img,.ecosystem-logo{transition:filter .2s}}
@media(max-width:700px){details>.ecosystem-heading .chain-list{grid-column:1;grid-row:2}.dex-standalone .ecosystem-heading{display:block}.dex-standalone .chain-list{margin-top:18px}.dex-standalone .ecosystem-heading>p{margin-top:12px;max-width:40ch}.chain-list{gap:12px 16px}}
</style>
