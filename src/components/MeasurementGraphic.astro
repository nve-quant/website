---
import {measurementViews} from '../data/measurement-graphic';
import MetricScene from './MetricScene.astro';
interface Props {id?:string}
const {id='measurement-explainer'}=Astro.props;
---
<div class="measurement-graphic" data-explainer-motion data-measurement-motion>
 <div class="measurement-toolbar"><fieldset class="measurement-choice"><legend>Explore the measures</legend>{measurementViews.map((view,index)=><label><input type="radio" name={`${id}-view`} value={view.id} checked={index===0}/><span>{view.label}</span></label>)}</fieldset><button class="measurement-pause" type="button" data-explainer-toggle hidden>Pause motion</button></div>
 {measurementViews.map(view=><div class="measurement-panel" data-measurement-view={view.id}>
  <fieldset class="metric-options"><legend>Select a measure</legend>{view.metrics.map((metric,index)=><label><input type="radio" name={`${id}-${view.id}-metric`} value={metric.id} checked={index===0}/><span class="metric-option-copy"><strong>{metric.title}</strong><span>{metric.question}</span></span><svg viewBox="0 0 20 20" width="20" height="20" aria-hidden="true"><path d="M4 10h12m-5-5 5 5-5 5"/></svg></label>)}</fieldset>
  <div class="metric-stage">{view.metrics.map(metric=><figure class="metric-example" data-metric={metric.id}><MetricScene kind={metric.id} id={`${id}-${metric.id}`}/><figcaption><h3>{metric.title}</h3><p>{metric.text}</p></figcaption></figure>)}</div>
 </div>)}
 <p class="measurement-caption">Illustrative sequences. Definitions, targets and review periods are agreed for each engagement.</p>
</div>
<style>
.measurement-graphic{grid-column:1/-1;min-width:0;color:var(--ink,#243f35)}.measurement-toolbar{display:flex;align-items:end;justify-content:space-between;gap:24px;border-bottom:1px solid var(--line);padding-bottom:20px}.measurement-choice{display:flex;flex-wrap:wrap;gap:4px;margin:0;padding:0;border:0}.measurement-choice legend{font-size:.75rem;color:var(--muted);margin-bottom:14px}.measurement-choice label{position:relative;cursor:pointer}.measurement-choice input,.metric-options input{position:absolute;opacity:0;width:1px;height:1px}.measurement-choice label>span{display:block;font-size:.85rem;padding:11px 16px;border:1px solid transparent}.measurement-choice input:checked+span{background:#243f35;color:#f6f7f2}.measurement-choice input:not(:checked)+span{border-color:var(--line)}.measurement-choice input:focus-visible+span,.metric-options input:focus-visible+.metric-option-copy{outline:3px solid #a13d00;outline-offset:4px}.measurement-pause{border:0;background:none;color:var(--muted);font:inherit;font-size:.75rem;text-decoration:underline;text-underline-offset:4px;padding:12px 0;cursor:pointer;flex:none}.measurement-panel{display:none;grid-template-columns:minmax(210px,.68fr) minmax(0,1.45fr);gap:clamp(26px,5vw,72px);padding-top:32px}.measurement-graphic:has(.measurement-choice input[value=cex]:checked) [data-measurement-view=cex],.measurement-graphic:has(.measurement-choice input[value=dex]:checked) [data-measurement-view=dex]{display:grid}.metric-options{padding:0;margin:0;border:0;min-width:0}.metric-options legend{font-size:.7rem;color:var(--muted);margin-bottom:14px}.metric-options label{position:relative;cursor:pointer;display:flex;align-items:center;justify-content:space-between;gap:18px;padding:22px 0;border-bottom:1px solid var(--line)}.metric-options label:first-of-type{border-top:1px solid var(--line)}.metric-option-copy{display:block;min-width:0}.metric-option-copy strong{font-size:1.15rem;font-weight:400;letter-spacing:-.025em;display:block;margin-bottom:9px}.metric-option-copy>span{font-size:.78rem;color:var(--muted);line-height:1.5;display:block;max-width:27ch}.metric-options svg{stroke:#243f35;stroke-width:1.3;fill:none;flex:none;opacity:.25}.metric-options input:checked~svg{opacity:1}.metric-options label:has(input:checked){border-bottom:2px solid #365a48}.metric-options input:checked+.metric-option-copy strong{font-weight:500}.metric-stage{min-width:0}.metric-example{display:none;margin:0}.measurement-panel:has(input[value=spread]:checked) [data-metric=spread],.measurement-panel:has(input[value=depth]:checked) [data-metric=depth],.measurement-panel:has(input[value=availability]:checked) [data-metric=availability],.measurement-panel:has(input[value=allocation]:checked) [data-metric=allocation],.measurement-panel:has(input[value=impact]:checked) [data-metric=impact],.measurement-panel:has(input[value=economics]:checked) [data-metric=economics]{display:block}.metric-example figcaption{padding:24px 0 0;min-height:122px}.metric-example h3{font-size:1.35rem;letter-spacing:-.03em;margin:0 0 10px}.metric-example figcaption p{font-size:.85rem!important;line-height:1.6;max-width:65ch;margin:0;color:var(--muted)}.measurement-caption{font-size:.7rem!important;color:var(--muted);margin:20px 0 0;line-height:1.6}
@media(max-width:760px){.measurement-panel{grid-template-columns:1fr;gap:24px}.metric-options{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:12px}.metric-options legend{grid-column:1/-1}.metric-options label,.metric-options label:first-of-type{border-top:0;padding:10px 0 14px;align-items:start}.metric-option-copy strong{font-size:.9rem;line-height:1.35;margin:0}.metric-option-copy>span,.metric-options svg{display:none}.metric-example figcaption{min-height:0;padding-top:20px}.measurement-toolbar{gap:12px}.measurement-choice label>span{padding:10px;font-size:.75rem}.measurement-pause{font-size:.68rem;max-width:54px;text-align:right;line-height:1.5}}
</style>
<script>
 import {initExplainerMotion} from '../scripts/explainer-motion';
 document.querySelectorAll<HTMLElement>('[data-measurement-motion]').forEach(initExplainerMotion);
</script>
