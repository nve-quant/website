---
interface Props {kind:'otc-deals'|'systematic-strategies'}
const {kind}=Astro.props;
const otc=kind==='otc-deals';
const items=otc ? [
 {title:'The trade',details:'Assets · size · counterparties'},
 {title:'The terms',details:'Pricing · execution · settlement'},
 {title:'The agreement',details:'A transaction-specific arrangement'},
] : [
 {title:'Strategy',details:'The trading approach'},
 {title:'Operating scope',details:'Capital · permissions · limits'},
 {title:'Delivery',details:'Trading terminal or managed vault'},
];
---
<figure class:list={['service-mechanism',{'is-strategy':!otc}]}>
 <div class="mechanism-track">{items.map((item,i)=><div class="mechanism-node"><svg viewBox="0 0 100 56" aria-hidden="true">{otc ? <>{i===0?<><path d="M13 15h27v26H13zM60 15h27v26H60z"/><path class="accent-line" d="M40 28h20"/><circle cx="50" cy="28" r="3"/></>:i===1?<><path d="M24 8h52v40H24zM34 20h32M34 28h22M34 36h28"/><circle cx="70" cy="36" r="3"/></>:<><path d="M18 13h40v30H18zM42 18h40v30H42z"/><path class="accent-line" d="m53 32 7 6 12-14"/></>}</>:<>{i===0?<><path d="M12 42h76M20 10v32"/><path class="accent-line" d="m20 34 12-9 12 5 14-15 12 7 14-12"/></>:i===1?<><path d="M14 14h72M14 42h72"/><path class="accent-line" d="M18 29h18l8-10 13 18 10-9h16"/><path stroke-dasharray="2 4" d="M14 28h72"/></>:<><path d="M12 11h32v25H12zM20 43h16M28 36v7M60 15h28v29H60z"/><circle cx="74" cy="29" r="7"/><path d="M74 24v10M69 29h10"/></>}</>}</svg><h4>{item.title}</h4><p>{item.details}</p></div>)}</div>
 <figcaption>{otc?'Transaction scope is agreed before execution.':'Strategy and delivery are scoped to the engagement.'}</figcaption>
</figure>
<style>
.service-mechanism{margin:24px 0 20px;padding:20px;background:#e9ede2;grid-column:1/-1;min-width:0}.mechanism-track{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:26px}.mechanism-node{position:relative;min-width:0}.mechanism-node:not(:last-child):after{content:'';position:absolute;left:calc(100% + 4px);top:29px;width:18px;border-top:1px solid #849779}.mechanism-node svg{display:block;width:100px;max-width:100%;height:56px;fill:none;stroke:#526457;stroke-width:1.2;stroke-linecap:round;stroke-linejoin:round}.mechanism-node .accent-line{stroke:#243f35;stroke-width:2}.mechanism-node circle{fill:#dce9a9}.mechanism-node h4{font-size:.88rem;font-weight:500;margin:12px 0 6px}.mechanism-node p{font-size:.75rem!important;line-height:1.5;margin:0!important;max-width:23ch}.service-mechanism figcaption{font-size:.7rem;color:#526457;margin-top:22px;padding-top:12px;border-top:1px solid #b4bfb1}
@media(max-width:500px){.mechanism-track{grid-template-columns:1fr;gap:18px}.mechanism-node{display:grid;grid-template-columns:70px 1fr;column-gap:12px}.mechanism-node svg{grid-row:1/3;width:70px}.mechanism-node h4{margin:5px 0}.mechanism-node p{max-width:none}.mechanism-node:not(:last-child):after{display:none}}
</style>
