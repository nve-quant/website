---
import {coreServices} from '../data/home';
import {site} from '../data/site';
import LiquidityDiagram from './LiquidityDiagram.astro';
---
<section id="services" class="liquidity-services" aria-labelledby="liquidity-title">
  <div class="liquidity-heading">
    <h2 id="liquidity-title">Two market structures.<br/>Active management in both.</h2>
    <p>Order books and liquidity pools work differently. The operation should reflect that.</p>
  </div>
  <div class="liquidity-pair">
    {coreServices.map(service => <article class={`liquidity-service liquidity-${service.id}`}>
      <p class="venue-label">{service.label}</p>
      <h3>{service.title}</h3>
      <LiquidityDiagram kind={service.id}/>
      <p class="liquidity-intro">{service.intro}</p>
      <p class="liquidity-detail">{service.detail}</p>
      <ul class="liquidity-scope">{service.scope.map(item => <li>{item}</li>)}</ul>
      <a class="liquidity-contact" href={`mailto:${site.email}?subject=${encodeURIComponent(service.contact)}`}>{service.contact}</a>
    </article>)}
  </div>
</section>
